---
import Layout from '../layouts/Layout.astro';
import { url } from '../utils/url';

const cases = [
  {
    category: '근골격계',
    title: '제조업 무릎 관절증',
    company: '제조업 / 남성',
    result: '산재 승인',
    amount: '124,786,110원',
    desc: '부산, 함안, 김해 등 제조업 공장에서 장기간 제관 업무 수행. 일부 사업장이 4대보험 미가입 상태였으나, 각종 자료를 수집하여 근무사실을 입증하고 산재 승인.',
    point: '휴업급여·장해급여 124,786,110원 수령',
  },
  {
    category: '근골격계',
    title: '건설업 15년 근무 형틀목공',
    company: '건설업 / 남성',
    result: '산재 승인',
    amount: '92,927,290원',
    desc: '"나이가 들어서 그렇겠지"라며 주저하셨으나, 의학적·법리적 쟁점 분석 및 인과관계 입증하여 산재 승인',
    point: '장해급여 92,927,290원 수령',
  },
  {
    category: '뇌심혈관',
    title: '화물차주 급성심근경색',
    company: '운송업 / 남성',
    result: '유족급여 인정',
    amount: '114,648,590원 + 매 월 연금',
    desc: '지병(고혈압)이 있으셨으나, 과로와 업무부담 가중요인 주장하여 산재 유족급여 인정',
    point: '유족급여·장례비 포함 114,648,590원\n + 매 월 연금 수령',
  },
  {
    category: '직업성 암',
    title: '자동차 공업사 근로자 폐암',
    company: '자동차 정비업 / 남성',
    result: '산재 승인',
    amount: '81,430,670원',
    desc: '업무 내용·근무환경 정리, 직업환경연구원 자료 및 산업안전보건공단 자료 등 제출하여 업무 중 발암물질 노출 입증을 통해 폐암 승인',
    point: '병원비·휴업급여 81,430,670원 수령',
  },
  {
    category: '근골격계',
    title: '도축업 근로자 어깨 회전근개 파열',
    company: '도축업 / 남성',
    result: '산재 승인',
    amount: '95,447,910원',
    desc: '어깨 부담이 극심한 장기간 도축 업무를 수행하면서 누적된 피로를 업무상 질병으로 인정.',
    point: '병원비·수술비·휴업급여·장해급여 등 95,447,910원 수령',
  },
  {
    category: '소음성 난청',
    title: '중공업 사상 작업자 소음성 난청',
    company: '중공업 / 남성',
    result: '산재 승인',
    amount: '69,101,200원',
    desc: '10년 이상 그라인더 사상 작업으로 인한 소음성 난청 주장. 70세 정도임에도 노인성이 아닌 산재로 인정.',
    point: '장해급여 69,101,200원 수령',
  },
];
---

<Layout
  title="성공사례"
  description="하온 노동법률사무소 산재 성공사례 - 소음성 난청, 심뇌혈관, 근골격계, 직업성 암, 출퇴근재해"
  keywords="산재승인사례, 산재성공사례, 장해급여, 유족급여, 산재보상금, 산재신청결과"
>

  <!-- 페이지 헤더 -->
  <section class="relative bg-gradient-to-br from-sky-400 via-blue-500 to-cyan-500 text-white py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-grid-white/[0.05] bg-[length:40px_40px]"></div>
    <div class="relative max-w-7xl mx-auto px-6">
      <div class="inline-block px-4 py-1.5 bg-white/20 backdrop-blur-md rounded-full mb-6 border border-white/30">
        <div class="text-xs text-white font-semibold tracking-wider">
          <a href={url("/")} class="hover:underline">홈</a>
          <span class="mx-2">•</span>
          <span>성공사례</span>
        </div>
      </div>
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-black mb-6 tracking-tight">성공사례</h1>
      <p class="text-xl md:text-2xl text-white/95 max-w-3xl leading-relaxed font-medium">
        하온 노동법률사무소가 의뢰인의 정당한 권리를 찾아드린<br class="hidden md:block" />
        실제 산재 승인 사례를 소개합니다
      </p>
    </div>
  </section>

  <!-- Cases grid -->
  <section class="py-20 md:py-32 bg-gray-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {cases.map((c) => (
          <div class="group bg-white border-2 border-gray-200 rounded-3xl overflow-hidden hover:border-blue-300 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
            <!-- Category badge header -->
            <div class="bg-blue-500 px-6 py-4">
              <div class="inline-block px-4 py-1.5 bg-white/20 backdrop-blur-sm rounded-full border border-white/30">
                <span class="text-xs font-bold text-white tracking-wider uppercase">{c.category}</span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-6 md:p-8">
              <!-- Title and company -->
              <div class="mb-5">
                <h3 class="text-xl md:text-2xl font-black text-gray-900 mb-3 leading-tight">{c.title}</h3>
                <div class="flex items-center gap-2 text-sm text-gray-500">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <span class="font-medium">{c.company}</span>
                </div>
              </div>

              <!-- Description -->
              <p class="text-base text-gray-700 leading-relaxed mb-6">{c.desc}</p>

              <!-- Result box -->
              <div class="bg-green-50 rounded-2xl p-5 border-2 border-green-100 mb-6">
                <div class="flex items-center gap-2 mb-2">
                  <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-sm font-bold text-green-600 uppercase tracking-wide">{c.result}</span>
                </div>
                <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-line">{c.point}</p>
              </div>

              <!-- Amount highlight -->
              <div class="bg-blue-600 rounded-2xl p-6 shadow-md">
                <p class="text-xs font-semibold text-blue-100 uppercase tracking-wider mb-2">총 수령 금액</p>
                <p class="text-2xl md:text-3xl font-black text-white">{c.amount}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- CTA Button -->
      <div class="mt-16 text-center">
        <a href="https://blog.naver.com/jswcpla/224054356423" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 px-10 py-5 bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-700 hover:to-cyan-600 text-white font-bold rounded-2xl transition-all shadow-xl hover:shadow-2xl hover:scale-105 text-base">
          전체 사례 더 보기
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 md:py-32 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 text-center text-white overflow-hidden">
    <div class="absolute inset-0 bg-grid-white/[0.02] bg-[length:40px_40px]"></div>
    <div class="relative max-w-4xl mx-auto px-6">
      <div class="inline-block px-5 py-2 bg-white/10 backdrop-blur-sm rounded-full mb-6 border border-white/20">
        <p class="text-white/90 font-semibold text-sm tracking-wider">무료 상담</p>
      </div>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black mb-5 tracking-tight">나도 산재 신청이 가능할까요?</h2>
      <p class="text-lg md:text-xl text-gray-300 mb-12 leading-relaxed max-w-2xl mx-auto">
        불승인을 받으셨어도 포기하지 마세요.<br class="hidden sm:block" />
        하온 노동법률사무소가 함께 다시 검토해드립니다.
      </p>
      <div class="flex flex-col sm:flex-row gap-5 justify-center">
        <a href={url("/consulting")} class="group inline-flex items-center justify-center gap-3 px-10 py-5 bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-700 hover:to-cyan-600 text-white font-black rounded-2xl transition-all shadow-xl hover:shadow-2xl hover:scale-105 text-base">
          무료상담 신청하기
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a href="tel:050713281579" class="inline-flex items-center justify-center gap-3 px-10 py-5 bg-white/10 backdrop-blur-md border-2 border-white/30 hover:bg-white/20 text-white font-bold rounded-2xl transition-all hover:scale-105 text-base">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          0507-1328-1579
        </a>
      </div>
    </div>
  </section>
</Layout>
