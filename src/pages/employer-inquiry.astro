---
import Layout from '../layouts/Layout.astro';
import { url } from '../utils/url';
---

<Layout
  title="사업주 문의"
  description="하온 노동법률사무소 사업주 인사노무 서비스 - 4대보험, 급여대행, 노동법률 자문, 사건대응, 고용지원금"
  keywords="사업주상담, 인사노무, 4대보험, 급여대행, 노동법률자문, 고용지원금, 부산노무사"
>

  <!-- Page header -->
  <section class="bg-navy-900 text-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-sm text-gold-400 mb-2">
        <a href={url("/")} class="hover:underline">홈</a>
        <span class="mx-2">/</span>
        <span>사업주 문의</span>
      </div>
      <h1 class="text-4xl font-black">사업주 인사노무 서비스</h1>
      <p class="mt-3 text-gray-300 max-w-xl">
        기업 성장을 위한 전문적인 인사노무 관리 서비스를 제공합니다
      </p>
    </div>
  </section>

  <!-- Introduction -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-16">
        <p class="text-gold-500 font-semibold text-sm uppercase tracking-wider mb-3">Employer Services</p>
        <h2 class="text-3xl font-black text-navy-900 leading-snug mb-6">
          복잡한 인사노무 업무,<br />
          전문가에게 맡기세요
        </h2>
        <p class="text-gray-600 leading-relaxed max-w-2xl mx-auto">
          4대보험 처리부터 급여 계산, 노동법률 자문까지 기업 운영에 필요한 모든 인사노무 서비스를 제공합니다.
          복잡하고 시간이 많이 소요되는 업무를 전문가에게 맡기고, 본업에 집중하세요.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid md:grid-cols-2 gap-8 mb-16">
        {[
          {
            title: '4대보험',
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 2A3.5 3.5 0 0 0 2 5.5v5A3.5 3.5 0 0 0 5.5 14h5a3.5 3.5 0 0 0 3.5-3.5V8a.5.5 0 0 1 1 0v2.5a4.5 4.5 0 0 1-4.5 4.5h-5A4.5 4.5 0 0 1 1 10.5v-5A4.5 4.5 0 0 1 5.5 1H8a.5.5 0 0 1 0 1z"/><path d="M16 3a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/></svg>`,
            items: [
              '국민연금, 건강보험, 고용보험, 산재보험 가입 및 관리',
              '4대보험 취득·상실 신고 대행',
              '보수총액신고, 정산 업무 처리',
              '4대보험 요율 변경 및 관리',
            ],
          },
          {
            title: '급여대행',
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" fill="currentColor" viewBox="0 0 16 16"><path d="M4 10.781c.148 1.667 1.513 2.85 3.591 3.003V15h1.043v-1.216c2.27-.179 3.678-1.438 3.678-3.3 0-1.59-.947-2.51-2.956-3.028l-.722-.187V3.467c1.122.11 1.879.714 2.07 1.616h1.47c-.166-1.6-1.54-2.748-3.54-2.875V1H7.591v1.233c-1.939.23-3.27 1.472-3.27 3.156 0 1.454.966 2.483 2.661 2.917l.61.162v4.031c-1.149-.17-1.94-.8-2.131-1.718zm3.391-3.836c-1.043-.263-1.6-.825-1.6-1.616 0-.944.704-1.641 1.8-1.828v3.495l-.2-.05zm1.591 1.872c1.287.323 1.852.859 1.852 1.769 0 1.097-.826 1.828-2.2 1.939V8.73z"/></svg>`,
            items: [
              '정확한 급여 계산 및 명세서 발급',
              '연말정산 대행 서비스',
              '퇴직금 계산 및 정산',
              '급여 관련 법률 준수 관리',
            ],
          },
          {
            title: '노동법률 자문',
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" fill="currentColor" viewBox="0 0 16 16"><path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464z"/></svg>`,
            items: [
              '취업규칙, 근로계약서 작성 및 검토',
              '인사·노무 관련 법률 자문',
              '근로시간, 휴게·휴일 관리 자문',
              '징계, 해고 절차 법률 검토',
            ],
          },
          {
            title: '노동사건 대응',
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" fill="currentColor" viewBox="0 0 16 16"><path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5 8 5.961 14.154 3.5zM15 4.239l-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464z"/><path d="m9.796 7.854 1.5-1.5a.5.5 0 0 1 .707.708l-1.853 1.853a.5.5 0 0 1-.708 0L7.5 7.207A.5.5 0 1 1 8.207 6.5z"/></svg>`,
            items: [
              '노동위원회 부당해고 구제신청 대응',
              '임금체불 진정·고소 사건 대응',
              '근로감독 및 조사 대응',
              '노동 관련 민사·형사 소송 지원',
            ],
          },
          {
            title: '고용지원금',
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" fill="currentColor" viewBox="0 0 16 16"><path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/><path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2z"/></svg>`,
            items: [
              '고용촉진장려금 신청 대행',
              '일자리 안정자금 신청 지원',
              '청년·고령자 고용지원금',
              '각종 정부 지원금 발굴 및 신청',
            ],
          },
        ].map((service) => (
          <div class="bg-white border-2 border-gray-100 rounded-2xl p-8 hover:border-gold-400 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
            <div class="flex items-start gap-4 mb-5">
              <div class="w-12 h-12 bg-gold-100 group-hover:bg-gold-400 rounded-xl flex items-center justify-center text-gold-600 group-hover:text-white shrink-0 transition-all duration-300 group-hover:scale-110">
                <div class="w-6 h-6" set:html={service.icon} />
              </div>
              <h3 class="text-2xl font-black text-navy-900 group-hover:text-gold-600 transition-colors duration-300">{service.title}</h3>
            </div>
            <ul class="space-y-3">
              {service.items.map((item) => (
                <li class="flex items-start gap-2 text-gray-600 group-hover:text-gray-700 transition-colors duration-300">
                  <svg class="w-5 h-5 text-gold-500 group-hover:text-gold-600 shrink-0 mt-0.5 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-sm leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Why Choose Us -->
      <div class="bg-gradient-to-br from-navy-900 to-navy-800 text-white rounded-2xl p-10">
        <h3 class="text-2xl font-black mb-8 text-gold-400">하온을 선택해야 하는 이유</h3>
        <div class="grid md:grid-cols-3 gap-8">
          {[
            {
              number: '01',
              title: '전문성',
              desc: '노동법률 전문가의 정확한 업무 처리',
            },
            {
              number: '02',
              title: '신속성',
              desc: '빠르고 정확한 서류 처리와 대응',
            },
            {
              number: '03',
              title: '신뢰성',
              desc: '투명한 비용과 성실한 업무 수행',
            },
          ].map((item) => (
            <div class="flex gap-4">
              <span class="text-4xl font-black text-gold-400/30">{item.number}</span>
              <div>
                <h4 class="font-bold text-lg mb-2">{item.title}</h4>
                <p class="text-gray-300 text-sm">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-gray-50 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-2xl font-black text-navy-900 mb-4">사업주 상담 신청</h2>
      <p class="text-gray-600 mb-8">인사노무 업무로 고민이시라면 언제든 문의하세요</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={url("/employer-consulting")} class="inline-block px-10 py-4 bg-navy-900 hover:bg-navy-800 text-white font-bold rounded-xl transition-colors">
          무료상담 신청하기
        </a>
        <a href="tel:050713281579" class="inline-flex items-center justify-center gap-2 px-10 py-4 border-2 border-navy-900 text-navy-900 font-bold rounded-xl hover:bg-navy-900 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          0507-1328-1579
        </a>
      </div>
    </div>
  </section>
</Layout>
