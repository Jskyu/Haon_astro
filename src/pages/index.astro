---
import Layout from '../layouts/Layout.astro';
import { url } from '../utils/url';
---

<Layout>

  <!-- Hero -->
  <section class="bg-navy-900 text-white">
    <div class="max-w-6xl mx-auto px-4 py-24 md:py-36">
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight mb-6">
          <span class="block lg:whitespace-nowrap"><span class="text-gold-400">하</span>늘아래 모든 분들이</span>
          <span class="block lg:whitespace-nowrap"><span class="text-gold-400">온</span>전한 행복을 누릴 수 있도록</span>
        </h1>
        <p class="text-lg text-gray-300 leading-relaxed mb-10 max-w-xl">
          4대보험·급여대행·노동법률 자문부터 부당해고·임금체불·산업재해 등<br class="sm:hidden" />
          하온 노동법률센터가 끝까지 함께합니다.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={url('/employee-consulting')} class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gold-500 hover:bg-gold-400 text-navy-900 font-bold text-base rounded-xl transition-colors">
            무료상담 신청하기
          </a>
          <a href="tel:050713281579" class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-white/30 hover:bg-white/10 text-white font-semibold text-base rounded-xl transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            0507-1328-1579
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8">
        <!-- 사업주 상담 -->
        <div class="space-y-4">
          <a
            href={url('/employer-consulting')}
            class="block bg-gradient-to-br from-gold-400 to-gold-500 p-8 rounded-2xl shadow-md hover:shadow-2xl transition-all duration-300 group overflow-hidden relative"
          >
            <div class="absolute inset-0 bg-gradient-to-br from-gold-300 to-gold-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative">
              <div class="flex items-center justify-between mb-3">
                <h2 class="text-3xl font-black text-navy-900 group-hover:translate-x-1 transition-transform duration-300">사업주 상담</h2>
                <svg class="w-8 h-8 text-navy-900 opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </div>
              <p class="text-navy-800">기업 성장을 위한 인사노무 전문 서비스</p>
            </div>
          </a>

          <div class="grid grid-cols-2 gap-4">
            {[
              { title: '4대보험', desc: '취득, 상실, 일용근로 등', icon: '📋' },
              { title: '급여대행', desc: '주휴, 연장 등 수당 반영', icon: '💰' },
              { title: '노동법률 자문', desc: '근로계약서, 취업규칙, 노사협의회 등', icon: '⚖️' },
              { title: '노동사건 대응', desc: '임금체불, 부당해고 등', icon: '🛡️' },
              { title: '고용지원금', desc: '각종 지원금 신청 대행', icon: '💵' },
            ].map((item, i) => (
              <a
                href={url('/employer-consulting')}
                class={`bg-white p-6 rounded-xl border-2 border-gray-100 hover:border-gold-400 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group ${i === 4 ? 'col-span-2' : ''}`}
              >
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-lg bg-gold-100 group-hover:bg-gold-400 flex items-center justify-center shrink-0 transition-all duration-300">
                    <span class="text-sm font-bold text-gold-600 group-hover:text-white transition-colors duration-300">{String(i + 1).padStart(2, '0')}</span>
                  </div>
                  <div class="flex-1">
                    <h3 class="font-bold text-navy-900 mb-1.5 group-hover:text-gold-600 transition-colors duration-300">{item.title}</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">{item.desc}</p>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- 근로자 상담 -->
        <div class="space-y-4">
          <a
            href={url('/employee-consulting')}
            class="block bg-gradient-to-br from-gold-400 to-gold-500 p-8 rounded-2xl shadow-md hover:shadow-2xl transition-all duration-300 group overflow-hidden relative"
          >
            <div class="absolute inset-0 bg-gradient-to-br from-gold-300 to-gold-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative">
              <div class="flex items-center justify-between mb-3">
                <h2 class="text-3xl font-black text-navy-900 group-hover:translate-x-1 transition-transform duration-300">근로자 상담</h2>
                <svg class="w-8 h-8 text-navy-900 opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </div>
              <p class="text-navy-800">부당한 대우로부터 권리를 보호합니다</p>
            </div>
          </a>

          <div class="grid grid-cols-1 gap-4">
            {[
              { title: '부당해고', desc: '부당해고등 구제신청, 복직 및 금전보상' },
              { title: '임금체불·퇴직금', desc: '노동청 임금체불 → 연차, 수당 등 숨은 금액까지' },
              { title: '대지급금', desc: '체불된 임금과 퇴직금을 국가에 청구' },
              { title: '산업재해', desc: '산재 신청부터 보상금 수령까지' },
            ].map((item, i) => (
              <a
                href={url('/employee-consulting')}
                class="bg-white p-6 rounded-xl border-2 border-gray-100 hover:border-gold-400 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group"
              >
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-lg bg-gold-100 group-hover:bg-gold-400 flex items-center justify-center shrink-0 transition-all duration-300">
                    <span class="text-sm font-bold text-gold-600 group-hover:text-white transition-colors duration-300">{String(i + 1).padStart(2, '0')}</span>
                  </div>
                  <div class="flex-1">
                    <h3 class="font-bold text-navy-900 mb-1.5 group-hover:text-gold-600 transition-colors duration-300">{item.title}</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">{item.desc}</p>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent cases -->
  <section class="py-20 bg-navy-900">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-12">
        <p class="text-gold-400 font-semibold text-sm tracking-widest uppercase mb-2">실제 사례</p>
        <h2 class="text-3xl md:text-4xl font-black text-white">최근 성공 사례</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            badge: '기업 노동법률 자문',
            title: '부산 강서구 제조업체',
            items: [
              '노동법률 자문',
              '근로계약서 – 포괄임금, 연장근로수당 등',
              '취업규칙 – 최신법령 반영, 정년, 연차 등',
              '노사협의회 – 근로자·사용자위원 선출 등',
              '직장 내 성희롱 예방·장애인 인식개선 교육'
            ]
          },
          {
            badge: '기업 노동법률 자문',
            title: '부산 강서구 서비스업',
            items: [
              '노동법률 자문',
              '근로계약서 –고정OT제 반영 등',
              '근로계약서 – 정규직·시급제 아르바이트 구분',
              '급여명세서 – 연장근로수당, 주휴수당 등 반영',
              '직장 내 성희롱 예방·장애인 인식개선 교육'
            ]
          },
          {
            badge: '근로자 임금체불',
            title: '고정OT 근로자의 임금체불',
            items: [
              '기본급의 최저임금법 위반 여부 확인',
              '식대, 통근수당 등의 통상임금성 확인',
              '연차반영한 미사용 연차수당 확인 <br/>→ 연장·야간·휴일 근로수당 재산정하여 노동청에 임금체불 진정'
            ]
          },
        ].map((c) => (
          <div class="bg-navy-800/50 p-8 rounded-xl border border-white/10 hover:border-gold-400/50 transition-colors">
            <span class="text-xs font-semibold text-gold-400 tracking-wider uppercase">{c.badge}</span>
            <h3 class="font-bold text-white text-lg mt-3 mb-6">{c.title}</h3>
            <ul class="space-y-3">
              {c.items.map((item) => (
                <li class="flex items-start gap-2.5 text-gray-300 text-sm leading-relaxed">
                  <svg class="w-4 h-4 text-gold-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span set:html={item}></span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="mt-10">
        <a href="https://blog.naver.com/jswcpla/224054356423" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-white/30 hover:border-gold-400 text-white hover:text-gold-400 font-semibold px-7 py-3 rounded-xl transition-colors text-sm">
          전체 사례 보기
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-black text-navy-900 mb-4">지금 바로 무료 상담 받으세요</h2>
      <p class="text-gray-500 mb-10 leading-relaxed">
        산재 신청 가능 여부가 불확실하신가요? 먼저 상담부터 해보세요.
        경험 많은 노무사가 15분 내 가능성을 판단해 드립니다.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={url('/employee-consulting')} class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-navy-900 hover:bg-navy-800 text-white font-bold rounded-xl transition-colors">
          온라인 상담 신청
        </a>
        <a href="tel:050713281579" class="inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-navy-900 text-navy-900 font-bold rounded-xl hover:bg-navy-900 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          전화 상담: 0507-1328-1579
        </a>
      </div>
    </div>
  </section>
</Layout>
