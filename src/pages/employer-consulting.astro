---
import Layout from '../layouts/Layout.astro';
import { url } from '../utils/url';

// EmailJS 환경 설정
const isTestEnv = import.meta.env.PUBLIC_EMAILJS_ENV === 'test';
const emailJsConfig = {
  publicKey: isTestEnv
    ? import.meta.env.PUBLIC_EMAILJS_TEST_PUBLIC_KEY
    : import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY,
  serviceId: isTestEnv
    ? import.meta.env.PUBLIC_EMAILJS_TEST_SERVICE_ID
    : import.meta.env.PUBLIC_EMAILJS_SERVICE_ID,
  templateId: isTestEnv
    ? import.meta.env.PUBLIC_EMAILJS_TEST_TEMPLATE_ID
    : import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID,
};
---

<Layout
  title="사업주 상담 신청"
  description="하온 노동법률사무소 사업주 상담 - 4대보험, 급여대행, 노동법률 자문, 노동사건 대응, 고용지원금"
  keywords="사업주상담, 인사노무, 4대보험, 급여대행, 노동법률자문, 부산노무사"
>

  <section class="bg-navy-900 text-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-sm text-gold-400 mb-2">
        <a href={url("/")} class="hover:underline">홈</a>
        <span class="mx-2">/</span>
        <span>사업주 상담 신청</span>
      </div>
      <h1 class="text-4xl font-black">사업주 상담 신청</h1>
      <p class="mt-3 text-gray-300 max-w-xl">
        기업 성장을 위한 전문적인 인사노무 관리 서비스를 상담받으세요.
      </p>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12">

        <!-- Form -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
            <h2 class="text-2xl font-black text-navy-900 mb-2">상담 신청서</h2>
            <p class="text-sm text-gray-500 mb-8">모든 항목을 입력해 주시면 더 정확한 상담이 가능합니다. <span class="text-red-500">*</span> 표시는 필수 항목입니다.</p>

            <form id="consulting-form" class="space-y-6" novalidate>
              <!-- Company name + CEO name -->
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="company" class="block text-sm font-semibold text-gray-700 mb-1.5">
                    회사명 <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    placeholder="(주)하온건설"
                    required
                    class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition"
                  />
                </div>
                <div>
                  <label for="name" class="block text-sm font-semibold text-gray-700 mb-1.5">
                    담당자 성함 <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="홍길동"
                    required
                    class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition"
                  />
                </div>
              </div>

              <!-- Phone + Email -->
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="phone" class="block text-sm font-semibold text-gray-700 mb-1.5">
                    연락처 <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="010-0000-0000"
                    required
                    class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">이메일</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="example@email.com"
                    class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition"
                  />
                </div>
              </div>

              <!-- Region + Employee count -->
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="region" class="block text-sm font-semibold text-gray-700 mb-1.5">
                    소재지 <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="region"
                    name="region"
                    placeholder="예: 부산 해운대구"
                    required
                    class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition"
                  />
                </div>
                <div>
                  <label for="employeeCount" class="block text-sm font-semibold text-gray-700 mb-1.5">직원 수</label>
                  <input
                    type="text"
                    id="employeeCount"
                    name="employeeCount"
                    placeholder="예: 15명"
                    class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition"
                  />
                </div>
              </div>

              <!-- Industry -->
              <div>
                <label for="industry" class="block text-sm font-semibold text-gray-700 mb-1.5">업종</label>
                <input
                  type="text"
                  id="industry"
                  name="industry"
                  placeholder="예: 건설업, 제조업, 서비스업 등"
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition"
                />
              </div>

              <!-- Consultation type -->
              <div>
                <label for="type" class="block text-sm font-semibold text-gray-700 mb-1.5">
                  상담 분야 <span class="text-red-500">*</span>
                </label>
                <select
                  id="type"
                  name="type"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition bg-white appearance-none"
                >
                  <option value="">— 해당 분야를 선택해 주세요 —</option>
                  <option value="4대보험">4대보험 가입 및 관리</option>
                  <option value="급여대행">급여 계산 및 대행</option>
                  <option value="노동법률 자문">노동법률 자문 (취업규칙, 근로계약 등)</option>
                  <option value="노동사건 대응">노동사건 대응 (노동위원회, 법원)</option>
                  <option value="고용지원금">고용지원금 신청</option>
                  <option value="산재 대응">산재 사고 대응</option>
                  <option value="근로감독 대응">근로감독 대응</option>
                  <option value="기타">기타</option>
                </select>
              </div>

              <!-- Message -->
              <div>
                <label for="message" class="block text-sm font-semibold text-gray-700 mb-1.5">
                  상담 내용 <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  required
                  placeholder="상담받고 싶은 내용을 자유롭게 작성해 주세요.

예시:
- 4대보험 신규 가입 및 관리
- 근로계약서 및 취업규칙 작성
- 임금체불 진정 사건 대응
- 고용지원금 신청 지원 등"
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition resize-none"
                ></textarea>
              </div>

              <!-- Contact time -->
              <div>
                <label for="contactTime" class="block text-sm font-semibold text-gray-700 mb-1.5">선호 연락 시간</label>
                <select
                  id="contactTime"
                  name="contactTime"
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition bg-white"
                >
                  <option value="상관없음">상관없음</option>
                  <option value="평일 오전 9시 – 12시">평일 오전 9시 – 12시</option>
                  <option value="평일 오후 12시 – 15시">평일 오후 12시 – 15시</option>
                  <option value="평일 오후 15시 – 18시">평일 오후 15시 – 18시</option>
                </select>
              </div>

              <!-- Privacy -->
              <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
                <input type="checkbox" id="privacy" name="privacy" required class="mt-0.5 accent-gold-600" />
                <label for="privacy" class="text-sm text-gray-600 cursor-pointer">
                  <span class="font-semibold text-gray-800">[필수] 개인정보 수집 및 이용에 동의합니다.</span><br />
                  수집 항목: 회사명, 담당자 정보, 연락처, 이메일 / 목적: 상담 진행 / 보유 기간: 상담 완료 후 1년
                </label>
              </div>

              <!-- Submit -->
              <button
                type="submit"
                class="w-full py-4 bg-navy-900 hover:bg-navy-800 text-white font-bold text-base rounded-xl transition-colors flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
                상담 신청하기
              </button>
            </form>

            <!-- Error message -->
            <div id="error-msg" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700 text-center">
              전송 중 오류가 발생했습니다. 잠시 후 다시 시도하거나 <a href="tel:050713281579" class="font-semibold underline">전화</a>로 문의해 주세요.
            </div>

            <!-- Success message -->
            <div id="success-msg" class="hidden text-center py-12">
              <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <h3 class="text-xl font-black text-navy-900 mb-2">상담 신청이 완료되었습니다!</h3>
              <p class="text-gray-500 text-sm">영업일 기준 24시간 이내에 연락드리겠습니다.<br />급하신 경우 <a href="tel:050713281579" class="text-gold-600 font-semibold hover:underline">0507-1328-1579</a>로 바로 전화해 주세요.</p>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Direct contact -->
          <div class="bg-navy-900 text-white rounded-2xl p-6">
            <h3 class="font-bold text-lg mb-4">바로 연락하기</h3>
            <div class="space-y-4">
              <a href="tel:050713281579" class="flex items-center gap-3 p-3.5 bg-white/10 hover:bg-white/20 rounded-xl transition-colors">
                <div class="w-10 h-10 bg-gold-500 rounded-lg flex items-center justify-center">
                  <svg class="w-5 h-5 text-navy-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-400">전화 상담</p>
                  <p class="font-bold">0507-1328-1579</p>
                </div>
              </a>
              <a href="mailto:jswcpla@gmail.com" class="flex items-center gap-3 p-3.5 bg-white/10 hover:bg-white/20 rounded-xl transition-colors">
                <div class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-400">이메일</p>
                  <p class="font-bold text-sm">jswcpla@gmail.com</p>
                </div>
              </a>
            </div>
          </div>

          <!-- Info box -->
          <div class="bg-blue-50 border-2 border-blue-200 rounded-2xl p-6">
            <h3 class="font-bold text-navy-900 mb-3">투명한 비용 안내</h3>
            <p class="text-sm text-gray-700 leading-relaxed">
              상담 후 업무 범위와 비용을 투명하게 안내드립니다.
              합리적인 가격으로 전문적인 서비스를 제공합니다.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script is:inline define:vars={{ emailJsConfig }}>
  // EmailJS 환경변수로부터 설정값 주입
  var EMAILJS_PUBLIC_KEY  = emailJsConfig.publicKey;
  var EMAILJS_SERVICE_ID  = emailJsConfig.serviceId;
  var EMAILJS_TEMPLATE_ID = emailJsConfig.templateId;

  emailjs.init({ publicKey: EMAILJS_PUBLIC_KEY });

  var form = document.getElementById('consulting-form');
  var successMsg = document.getElementById('success-msg');
  var errorMsg = document.getElementById('error-msg');
  var submitBtn = form && form.querySelector('button[type="submit"]');
  var submitBtnOriginalHTML = submitBtn && submitBtn.innerHTML;

  form && form.addEventListener('submit', function(e) {
    e.preventDefault();

    var required = form.querySelectorAll('[required]');
    var valid = true;

    required.forEach(function(el) {
      if (!el.value.trim() || (el.type === 'checkbox' && !el.checked)) {
        valid = false;
        el.classList.add('ring-2', 'ring-red-400', 'border-red-400');
        el.addEventListener('input', function() {
          el.classList.remove('ring-2', 'ring-red-400', 'border-red-400');
        }, { once: true });
      }
    });

    if (!valid) {
      var firstInvalid = form.querySelector('.ring-red-400');
      firstInvalid && firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> 전송 중...';
    }
    errorMsg && errorMsg.classList.add('hidden');

    emailjs.sendForm(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, form)
      .then(function() {
        form.classList.add('hidden');
        successMsg && successMsg.classList.remove('hidden');
      })
      .catch(function(err) {
        console.error('EmailJS 오류:', err);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = submitBtnOriginalHTML;
        }
        errorMsg && errorMsg.classList.remove('hidden');
      });
  });
</script>
