---
import { url, base } from '../utils/url';

const pathname = Astro.url.pathname;
const active = (path: string) => {
  const full = url(path);
  return pathname === full || pathname === full + '/';
};
---

<header class="bg-white/95 backdrop-blur-sm text-neutral-900 shadow-soft sticky top-0 z-50 border-b border-neutral-100/50">
  <!-- Top bar -->
  <div class="bg-warm-700 text-sm py-2.5 hidden md:block">
    <div class="max-w-7xl mx-auto px-4 flex justify-end gap-8 text-warm-50">
      <a href="tel:050713281579" class="flex items-center gap-2 hover:text-white transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span class="font-medium">0507-1328-1579</span>
      </a>
      <a href="mailto:jswcpla@gmail.com" class="flex items-center gap-2 hover:text-white transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span class="font-medium">jswcpla@gmail.com</span>
      </a>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="font-medium">평일 09:00–18:00</span>
      </span>
    </div>
  </div>

  <!-- Main nav -->
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href={url('/')} class="flex items-center gap-3 group">
        <div class="w-14 h-14 bg-gradient-to-br from-warm-500 to-warm-600 rounded-2xl flex items-center justify-center group-hover:scale-105 transition-transform shadow-medium">
          <span class="text-white font-black text-2xl">하온</span>
        </div>
        <div class="leading-tight">
          <div class="font-black text-xl tracking-tight text-neutral-900">하온 노동법률사무소</div>
          <div class="text-xs text-warm-600 tracking-wider font-semibold">HAON LABOR LAW OFFICE</div>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-2">
        <a href={url('/')}
           class={`px-4 py-2.5 rounded-xl text-sm font-semibold hover:bg-neutral-50 transition-all ${active('/') ? 'bg-warm-600 text-white' : 'text-neutral-700'}`}>
          홈
        </a>
        <a href={url('/company-overview')}
           class={`px-4 py-2.5 rounded-xl text-sm font-semibold hover:bg-neutral-50 transition-all ${active('/company-overview') ? 'bg-warm-600 text-white' : 'text-neutral-700'}`}>
          대표 인사말
        </a>
        <a href={url('/employer-inquiry')}
           class={`px-4 py-2.5 rounded-xl text-sm font-semibold hover:bg-neutral-50 transition-all ${active('/employer-inquiry') ? 'bg-warm-600 text-white' : 'text-neutral-700'}`}>
          사업주 문의
        </a>
        <a href={url('/employee-inquiry')}
           class={`px-4 py-2.5 rounded-xl text-sm font-semibold hover:bg-neutral-50 transition-all ${active('/employee-inquiry') ? 'bg-warm-600 text-white' : 'text-neutral-700'}`}>
          근로자 문의
        </a>
        <a href={url('/location')}
           class={`px-4 py-2.5 rounded-xl text-sm font-semibold hover:bg-neutral-50 transition-all ${active('/location') ? 'bg-warm-600 text-white' : 'text-neutral-700'}`}>
          오시는 길
        </a>

        <div class="relative ml-3">
          <button id="consulting-btn"
                  class="group px-6 py-2.5 bg-warm-500 hover:bg-warm-600 text-white font-semibold text-sm rounded-xl transition-all shadow-medium flex items-center gap-2">
            <span>상담 신청</span>
            <svg id="consulting-arrow" class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id="consulting-dropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-hard border border-neutral-100 overflow-hidden z-50">
            <a href={url('/employer-consulting')}
               class="flex items-center gap-3 px-5 py-4 text-sm text-gray-700 hover:bg-warm-50/50 hover:text-warm-700 transition-colors group">
              <div class="w-10 h-10 bg-warm-100/50 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5 text-warm-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <span class="font-semibold">사업주 상담</span>
            </a>
            <a href={url('/employee-consulting')}
               class="flex items-center gap-3 px-5 py-4 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-600 transition-colors border-t border-neutral-100/50 group">
              <div class="w-10 h-10 bg-primary-100 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              </div>
              <span class="font-semibold">근로자 상담</span>
            </a>
          </div>
        </div>
      </nav>

      <!-- Mobile hamburger -->
      <button id="hamburger" class="lg:hidden p-2.5 rounded-xl hover:bg-neutral-50 transition-colors" aria-label="메뉴 열기">
        <svg id="hamburger-icon" class="w-6 h-6 text-neutral-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 text-neutral-900 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-neutral-100/50">
    <div class="max-w-7xl mx-auto px-4 py-6 space-y-2">
      <a href={url('/')} class="block px-4 py-3 text-sm font-semibold text-neutral-700 hover:bg-neutral-50 rounded-xl transition-colors">홈</a>
      <a href={url('/company-overview')} class="block px-4 py-3 text-sm font-semibold text-neutral-700 hover:bg-neutral-50 rounded-xl transition-colors">대표 인사말</a>
      <a href={url('/employer-inquiry')} class="block px-4 py-3 text-sm font-semibold text-neutral-700 hover:bg-neutral-50 rounded-xl transition-colors">사업주 문의</a>
      <a href={url('/employee-inquiry')} class="block px-4 py-3 text-sm font-semibold text-neutral-700 hover:bg-neutral-50 rounded-xl transition-colors">근로자 문의</a>
      <a href={url('/location')} class="block px-4 py-3 text-sm font-semibold text-neutral-700 hover:bg-neutral-50 rounded-xl transition-colors">오시는 길</a>

      <div class="pt-4">
        <button id="mobile-consulting-btn"
                class="w-full py-4 bg-warm-500 hover:bg-warm-600 text-white font-semibold text-sm rounded-xl flex items-center justify-center gap-2 shadow-medium">
          <span>상담 신청</span>
          <svg id="mobile-consulting-arrow" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-consulting-dropdown" class="hidden mt-3 space-y-2">
          <a href={url('/employer-consulting')}
             class="flex items-center gap-3 px-4 py-3.5 bg-warm-50 text-warm-700 text-sm font-semibold rounded-xl hover:bg-warm-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            사업주 상담
          </a>
          <a href={url('/employee-consulting')}
             class="flex items-center gap-3 px-4 py-3.5 bg-primary-50 text-primary-600 text-sm font-semibold rounded-xl hover:bg-primary-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            근로자 상담
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  hamburger?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  const consultingBtn = document.getElementById('consulting-btn');
  const consultingDropdown = document.getElementById('consulting-dropdown');
  const consultingArrow = document.getElementById('consulting-arrow');

  consultingBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    consultingDropdown?.classList.toggle('hidden');
    consultingArrow?.classList.toggle('rotate-180');
  });

  document.addEventListener('click', () => {
    consultingDropdown?.classList.add('hidden');
    consultingArrow?.classList.remove('rotate-180');
  });

  const mobileConsultingBtn = document.getElementById('mobile-consulting-btn');
  const mobileConsultingDropdown = document.getElementById('mobile-consulting-dropdown');
  const mobileConsultingArrow = document.getElementById('mobile-consulting-arrow');

  mobileConsultingBtn?.addEventListener('click', () => {
    mobileConsultingDropdown?.classList.toggle('hidden');
    mobileConsultingArrow?.classList.toggle('rotate-180');
  });
</script>
