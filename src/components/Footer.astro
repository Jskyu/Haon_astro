---
import { url, base } from '../utils/url';
---

<footer class="bg-navy-900 text-gray-300 relative overflow-hidden">
  <!-- Subtle background decoration -->
  <div class="absolute inset-0 opacity-[0.05]">
    <div class="absolute top-0 right-0 w-96 h-96 bg-gold-400 rounded-full filter blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-navy-400 rounded-full filter blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-16 relative">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-12 h-12 bg-gradient-to-br from-warm-500 to-warm-600 rounded-2xl flex items-center justify-center shadow-medium">
            <span class="text-white font-black text-xl">하온</span>
          </div>
          <div class="leading-tight">
            <div class="font-bold text-white text-lg">하온 노동법률사무소</div>
            <div class="text-xs text-gold-300 tracking-wider font-semibold">HAON LABOR LAW OFFICE</div>
          </div>
        </div>

        <p class="text-sm leading-relaxed text-gold-100 mb-8 max-w-md">
          <span class="text-gold-200 font-semibold">'하'</span>늘 아래 모든 일터가 <span class="text-gold-200 font-semibold">'온'</span>전히 존중받는 곳이 될 수 있도록,<br />
          여러분의 정당한 권리를 되찾아 드립니다.
        </p>

        <div class="flex gap-3">
          <a href="http://pf.kakao.com/_xhkxccn/chat" target="_blank" rel="noopener noreferrer"
             aria-label="카카오톡 채널"
             class="w-11 h-11 bg-yellow-400 hover:bg-yellow-500 rounded-xl flex items-center justify-center text-gray-900 transition-all shadow-medium hover:scale-110">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 3C6.477 3 2 6.477 2 10.857c0 2.757 1.65 5.187 4.148 6.697l-.853 3.186 3.668-2.426C9.589 18.43 10.78 18.6 12 18.6c5.523 0 10-3.478 10-7.743S17.523 3 12 3z"/>
            </svg>
          </a>
          <a href="tel:050713281579" aria-label="전화상담"
             class="w-11 h-11 bg-gold-400 hover:bg-gold-300 rounded-xl flex items-center justify-center text-white transition-all shadow-medium hover:scale-110">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </a>
          <a href="mailto:jswcpla@gmail.com" aria-label="이메일"
             class="w-11 h-11 bg-navy-500 hover:bg-navy-400 rounded-xl flex items-center justify-center text-white transition-all shadow-medium hover:scale-110">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick links -->
      <div class="lg:col-span-3">
        <h3 class="text-white font-bold mb-5 text-base flex items-center gap-2">
          <div class="w-1 h-5 bg-gold-400 rounded-full"></div>
          사무소 안내
        </h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={url('/company-overview')}
               class="flex items-center gap-2 hover:text-gold-300 transition-colors group">
              <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 -ml-1 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span>대표 인사말</span>
            </a>
          </li>
          <li>
            <a href={url('/employer-inquiry')}
               class="flex items-center gap-2 hover:text-gold-300 transition-colors group">
              <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 -ml-1 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span>사업주 문의</span>
            </a>
          </li>
          <li>
            <a href={url('/employee-inquiry')}
               class="flex items-center gap-2 hover:text-gold-300 transition-colors group">
              <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 -ml-1 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span>근로자 문의</span>
            </a>
          </li>
          <li>
            <a href={url('/location')}
               class="flex items-center gap-2 hover:text-gold-300 transition-colors group">
              <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 -ml-1 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span>오시는 길</span>
            </a>
          </li>
        </ul>

        <div class="mt-8">
          <h4 class="text-white font-semibold mb-3 text-sm">상담 신청</h4>
          <ul class="space-y-2 text-sm">
            <li>
              <a href={url('/employer-consulting')}
                 class="inline-flex items-center gap-2 px-4 py-2 bg-navy-400/10 hover:bg-navy-400/20 border border-primary-400/20 rounded-lg text-gold-200 hover:text-gold-100 transition-all">
                <span>사업주 상담</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </li>
            <li>
              <a href={url('/employee-consulting')}
                 class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/15 border border-white/20 rounded-lg hover:text-white transition-all">
                <span>근로자 상담</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Contact -->
      <div class="lg:col-span-4">
        <h3 class="text-white font-bold mb-5 text-base flex items-center gap-2">
          <div class="w-1 h-5 bg-gold-400 rounded-full"></div>
          연락처
        </h3>
        <ul class="space-y-4 text-sm">
          <li class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-gold-400/10 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="flex-1">
              <div class="text-gold-400 text-xs mb-0.5">주소</div>
              <span class="text-gold-100">부산 북구 백양대로 1167-1, 2층</span>
            </div>
          </li>

          <li class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-gold-400/10 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div class="flex-1">
              <div class="text-gold-400 text-xs mb-0.5">전화</div>
              <a href="tel:050713281579" class="text-gold-100 hover:text-white transition-colors font-medium">
                0507-1328-1579
              </a>
            </div>
          </li>

          <li class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-navy-400/10 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
              </svg>
            </div>
            <div class="flex-1">
              <div class="text-gold-300 text-xs mb-0.5">팩스</div>
              <span class="text-gold-100">051-719-9608</span>
            </div>
          </li>

          <li class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-gold-400/10 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="flex-1">
              <div class="text-gold-400 text-xs mb-0.5">이메일</div>
              <a href="mailto:jswcpla@gmail.com" class="text-gold-100 hover:text-white transition-colors">
                jswcpla@gmail.com
              </a>
            </div>
          </li>

          <li class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-navy-400/10 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="flex-1">
              <div class="text-gold-300 text-xs mb-0.5">운영시간</div>
              <span class="text-gold-100">평일 09:00–18:00</span>
              <div class="text-gold-400 text-xs mt-0.5">(토·일·공휴일 휴무)</div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-gold-300">
      <p class="text-center sm:text-left">
        &copy; 2024 하온 노동법률사무소. All rights reserved.
      </p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-white transition-colors">개인정보처리방침</a>
        <a href="#" class="hover:text-white transition-colors">이용약관</a>
      </div>
    </div>
  </div>
</footer>
