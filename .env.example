# EmailJS Configuration
# 운영 환경 (Production)
PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here
PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here

# 테스트 환경 (Test)
PUBLIC_EMAILJS_TEST_PUBLIC_KEY=your_test_public_key_here
PUBLIC_EMAILJS_TEST_SERVICE_ID=your_test_service_id_here
PUBLIC_EMAILJS_TEST_TEMPLATE_ID=your_test_template_id_here

# 현재 사용할 환경 (production 또는 test)
PUBLIC_EMAILJS_ENV=production
